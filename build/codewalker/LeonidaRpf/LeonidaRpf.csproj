<Project Sdk="Microsoft.NET.Sdk">
  <!-- Leonida's RPF helper: a small console program on CodeWalker.Core (dexyfex) that edits GTA V Enhanced .rpf
       archives in the game's mods\ folder. Built locally by build/codewalker/build_helper.py from CodeWalker's own
       GitHub source (never re-hosted). net48: .NET Framework 4.8 ships with Windows 10/11, so no extra runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>LeonidaRpf</AssemblyName>
    <RootNamespace>LeonidaRpf</RootNamespace>
    <Nullable>disable</Nullable>
    <CodeWalkerSrc Condition="'$(CodeWalkerSrc)' == ''">..\.cw-src</CodeWalkerSrc>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(CodeWalkerSrc)\CodeWalker.Core\CodeWalker.Core.csproj" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
  </ItemGroup>
</Project>
